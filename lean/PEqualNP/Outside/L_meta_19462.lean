-- the entries key + 1 :: clause of the clauses of the formula that have a key
noncomputable def fb (G : List (List ℕ)) (ks : List ℕ) : List (List ℕ) :=
  List.rec (motive := fun _ => List ℕ → List (List ℕ)) (fun _ => [])
    (fun c _ ih ks =>
      List.rec (motive := fun _ => List (List ℕ)) []
        (fun q qs _ => Bool.rec ((q :: c) :: ih qs) (ih qs) (Nat.beq q (nat_lit 0))) ks)
    G ks

-- the literals of a new clause: the tokens of w up to the 0 that ends the clause
-- (the codes of a new clause are always in one word)
noncomputable def lits (fuel w : ℕ) : List ℕ :=
  Nat.rec (motive := fun _ => ℕ → List ℕ) (fun _ => [])
    (fun _ ih w => Bool.rec (cl (cx w) :: ih (nx w)) [] (Nat.beq (cl (cx w)) (nat_lit 0)))
    fuel w

-- The new clauses of one word that are used in segment c or later, as entries
-- key + 1 :: clause, then rest.
noncomputable def ew (c fuel w : ℕ) (rest : List (List ℕ)) : List (List ℕ) :=
  Nat.rec (motive := fun _ => ℕ → List (List ℕ)) (fun _ => rest)
    (fun _ ih w =>
      Bool.rec
        (Bool.rec (ih (nx w))
          (Bool.rec (ih (nx w))
            ((Nat.succ (Nat.shiftRight (cx w) (nat_lit 1)) ::
                lits (nat_lit 2048) (nx w)) :: ih (nx w))
            (Nat.ble c (Nat.land (cx w) (nat_lit 1))))
          (Nat.ble (nat_lit 15) (Nat.land w (nat_lit 15))))
        rest (Nat.beq w (nat_lit 1)))
    fuel w

-- the same for a list of words
noncomputable def ent (c : ℕ) (ws : List ℕ) : List (List ℕ) :=
  List.rec (motive := fun _ => List (List ℕ)) []
    (fun w _ ih => ew c (nat_lit 2048) w ih) ws

