-- Written by mklratN.py (after gennot.py, genrow.py of notes/data/lrat-link).
-- No circuit of AND, OR and NOT gates of fan-in at most two with at most 5 gates
-- represents the 4 by 4 graph with mask 6126: the formula enc2 of LinkN on the
-- rows of the representing problem has no model. The certificate is LRAT from CaDiCaL,
-- trimmed (2421 steps, 44730 hints, 6 segment(s), solver options --unsat --shrink=0 --chrono=0 --minimizedepth=0 --rephase=0).
-- It is stored as codes of variable length: dec turns a list of words into the token
-- list of the checker of the LRAT library (one token per word for runW, below a top
-- bit), inside the kernel. The soundness of the checker holds for every token list
-- and every list of live clauses, so dec and ent need no proof.

namespace PEqualNP.Outside.L_meta_19493_aux

open PEqualNP.Library.LRAT PEqualNP.Library.LRAT.LinkN

def F : List (List ℕ) :=
  enc2 (4 + 4) 5 (PEqualNP.Library.LRAT.Promise.gMask 4 4 6126) (PEqualNP.Library.LRAT.Promise.repRows 4 4)

-- A code is a class number in 4 bits and a payload. WD: the payload widths of
-- the classes (fields of 8 bits); BS: their bases (fields of 32 bits); TB: the table
-- of the literals (fields of 15 bits); DU: for a key, the place in TB of the unit
-- literal that usually follows it as a hint (fields of 10 bits).
def WD : ℕ := 0x100c0a0908060c0a0809070605050400

def BS : ℕ := 0x7400000034000000140000000400000000000000500000001000000000000000111000000910000005100000031000000110000000100000000

def TB : ℕ := 

def DU : ℕ := 

-- width of the payload of the first code of the word w
noncomputable def cw (w : ℕ) : ℕ :=
  Nat.land (Nat.shiftRight WD (Nat.mul (nat_lit 8) (Nat.land w (nat_lit 15)))) (nat_lit 255)

-- base plus payload of the first code
noncomputable def cx (w : ℕ) : ℕ :=
  Nat.add (Nat.land (Nat.shiftRight BS (Nat.mul (nat_lit 32) (Nat.land w (nat_lit 15))))
      (nat_lit 4294967295))
    (Nat.land (Nat.shiftRight w (nat_lit 4))
      (Nat.sub (Nat.shiftLeft (nat_lit 1) (cw w)) (nat_lit 1)))

-- the word after its first code
noncomputable def nx (w : ℕ) : ℕ :=
  Nat.shiftRight w (Nat.add (nat_lit 4) (cw w))

-- entry x of the table of the literals (the table is stored from the top)
noncomputable def cl (x : ℕ) : ℕ :=
  Nat.land (Nat.shiftRight TB (Nat.mul (nat_lit 15) (Nat.sub (nat_lit 739) x)))
    (nat_lit 32767)

-- the usual unit literal of the key x
noncomputable def cu (x : ℕ) : ℕ :=
  cl (Nat.land (Nat.shiftRight DU (Nat.mul (nat_lit 10) (Nat.sub (nat_lit 4853) x)))
    (nat_lit 1023))

-- The tokens of one word (each plus e), then rest. A class below 7 is a literal
-- (or the 0 that ends a clause), a class from 7 below 10 a key, a class from
-- 10 below 15 a key and its usual unit literal, a class from 15 the key
-- of a new clause, times 8, plus the number of the last segment that uses it.
noncomputable def dw (e fuel w : ℕ) (rest : List ℕ) : List ℕ :=
  Nat.rec (motive := fun _ => ℕ → List ℕ) (fun _ => rest)
    (fun _ ih w =>
      Bool.rec
        (Bool.rec (Nat.add (cl (cx w)) e :: ih (nx w))
          (Bool.rec (Nat.add (cx w) e :: ih (nx w))
            (Bool.rec (Nat.add (cx w) e :: Nat.add (cu (cx w)) e :: ih (nx w))
              (Nat.add (Nat.shiftRight (cx w) (nat_lit 3)) e :: ih (nx w))
              (Nat.ble (nat_lit 15) (Nat.land w (nat_lit 15))))
            (Nat.ble (nat_lit 10) (Nat.land w (nat_lit 15))))
          (Nat.ble (nat_lit 7) (Nat.land w (nat_lit 15))))
        rest (Nat.beq w (nat_lit 1)))
    fuel w

-- the tokens of a list of words
noncomputable def dec (e : ℕ) (ws : List ℕ) : List ℕ :=
  List.rec (motive := fun _ => List ℕ) [] (fun w _ ih => dw e (nat_lit 2048) w ih) ws

